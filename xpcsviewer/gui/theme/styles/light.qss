/* Light theme overrides for XPCS-TOOLKIT
   Warm off-white surfaces with teal instrument accents
   Applied after base.qss when light theme is active
*/

/* ========================================
   Light-specific refinements
   ======================================== */

/* Tooltips with warm border */
QToolTip {
    border-color: #C4C3BE;
}

/* Disabled button — warm gray */
QPushButton:disabled {
    background-color: #C4C3BE;
    color: #8A8A84;
}

/* Scrollbar handles — warm gray */
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #C4C3BE;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #8A8A84;
}

/* Alternating list rows */
QListView::item:alternate {
    background-color: #F0EFEC;
}

/* GroupBox title — warm secondary */
QGroupBox::title {
    color: #64645F;
}

/* Input placeholders */
QLineEdit::placeholder {
    color: #8A8A84;
}

/* Tab refinements */
QTabBar::tab:selected {
    background-color: #FAFAF8;
    color: #1A1A1A;
}

QTabBar::tab:!selected {
    color: #64645F;
}

/* Progress bar chunk — teal */
QProgressBar::chunk {
    background-color: #0D9488;
}

/* Spin box buttons — warm surfaces */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #F0EFEC;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #E2E1DD;
}

/* Slider groove */
QSlider::groove:horizontal {
    background-color: #E2E1DD;
}

/* TreeView branch indicators */
QTreeView::branch:has-children:open,
QTreeView::branch:has-children:closed {
    border-image: none;
    image: none;
}

/* Table headers — warm surface */
QHeaderView::section {
    background-color: #F0EFEC;
    color: #1A1A1A;
    border: none;
    border-bottom: 1px solid #C4C3BE;
    padding: 6px 8px;
    font-weight: 500;
}

QHeaderView::section:hover {
    background-color: #E2E1DD;
}

/* Table corner button */
QTableView QTableCornerButton::section {
    background-color: #F0EFEC;
    border: none;
    border-bottom: 1px solid #C4C3BE;
    border-right: 1px solid #C4C3BE;
}

/* Dark theme overrides for XPCS-TOOLKIT
   Deep blue-gray instrument panels with bright teal phosphor accents
   Applied after base.qss when dark theme is active
*/

/* ========================================
   Dark-specific refinements
   ======================================== */

/* Disabled button — muted blue-gray */
QPushButton:disabled {
    background-color: @border_strong;
    color: @text_disabled;
}

/* Selected items — bright teal with dark text */
QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: @accent_primary;
    color: @background_primary;
}

/* Scrollbar handles — blue-gray */
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: @border_strong;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: @text_disabled;
}

/* Scrollbar background */
QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: @background_secondary;
}

/* Tab bar — dark instrument panel */
QTabBar::tab:selected {
    background-color: @background_primary;
    color: @text_primary;
}

QTabBar::tab:!selected {
    background-color: @background_secondary;
    color: @text_placeholder;
}

QTabBar::tab:hover:!selected {
    background-color: @background_elevated;
}

/* Input fields — blue-gray */
QLineEdit, QTextEdit, QComboBox {
    background-color: @background_secondary;
    border-color: @border_strong;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border-color: @accent_primary;
}

/* Combo box dropdown */
QComboBox::drop-down {
    border-left: 1px solid @border_strong;
}

QComboBox QAbstractItemView {
    background-color: @background_secondary;
    border-color: @border_strong;
}

/* Group box — blue-gray panel */
QGroupBox {
    background-color: @background_secondary;
    border-color: @border_strong;
}

QGroupBox::title {
    color: @text_placeholder;
}

/* Spin box — blue-gray */
QSpinBox, QDoubleSpinBox {
    background-color: @background_secondary;
    border-color: @border_strong;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: @background_elevated;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @border_strong;
}

/* Slider groove */
QSlider::groove:horizontal {
    background-color: @background_elevated;
}

/* Progress bar — teal phosphor */
QProgressBar {
    background-color: @background_elevated;
    border-color: @border_strong;
}

QProgressBar::chunk {
    background-color: @accent_primary;
}

/* Checkbox and radio — blue-gray unchecked */
QCheckBox::indicator:unchecked,
QRadioButton::indicator:unchecked {
    border-color: @text_disabled;
    background-color: @background_secondary;
}

/* Tooltips — elevated blue-gray */
QToolTip {
    background-color: @background_elevated;
    border-color: @border_strong;
}

/* Menu bar — blue-gray */
QMenuBar {
    background-color: @background_secondary;
    border-bottom-color: @background_elevated;
}

/* Status bar — blue-gray */
QStatusBar {
    background-color: @background_secondary;
    border-top-color: @background_elevated;
}

/* TreeView branch indicators */
QTreeView::branch:has-children:open,
QTreeView::branch:has-children:closed {
    border-image: none;
    image: none;
}

/* Alternating list rows */
QListView::item:alternate {
    background-color: @background_secondary;
}

/* Table headers — blue-gray */
QHeaderView::section {
    background-color: @background_secondary;
    color: @text_primary;
    border: none;
    border-bottom: 1px solid @border_strong;
    padding: 6px 8px;
    font-weight: 500;
}

QHeaderView::section:hover {
    background-color: @background_elevated;
}

/* Table corner button */
QTableView QTableCornerButton::section {
    background-color: @background_secondary;
    border: none;
    border-bottom: 1px solid @border_strong;
    border-right: 1px solid @border_strong;
}

/* Tree and list views — blue-gray */
QTreeView, QListView {
    background-color: @background_secondary;
    border-color: @border_strong;
}

/* Menu — elevated blue-gray with teal selection */
QMenu {
    background-color: @background_elevated;
    border-color: @border_strong;
}

QMenu::item:selected {
    background-color: @accent_primary;
    color: @background_primary;
}

/* Splitter handles — teal on hover */
QSplitter::handle {
    background-color: @border_strong;
}

QSplitter::handle:hover {
    background-color: @accent_primary;
}
